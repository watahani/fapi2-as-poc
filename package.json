{
  "name": "ai-authorization-server",
  "version": "0.0.1",
  "private": true,
  "description": "FAPI 2.0 Security Profile authorization server PoC — scratch implementation (auth/authz separation, AuthZEN PDP)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --max-old-space-size=256 dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "keys:rotate": "tsx src/db/keys-rotate.ts",
    "seed:clients": "tsx src/db/seed-clients.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:conformance": "vitest run --config vitest.conformance.config.ts"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
